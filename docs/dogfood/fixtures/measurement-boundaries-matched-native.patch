+    def test_symlink_state_directory_refused_without_mutation(self):
+        target = Path(self.tmp.name) / "target"
+        m.begin(target, start())
+        (target / "sentinel").write_bytes(b"synthetic sentinel\n")
+        ledger = (target / "events.jsonl").read_bytes()
+        self.state.symlink_to(target, target_is_directory=True)
+        self.reject_begin(start("b"))
+        self.assertTrue(self.state.is_symlink())
+        self.assertEqual(os.readlink(self.state), str(target))
+        self.assertEqual(target.stat().st_mode & 0o777, 0o700)
+        self.assertEqual(sorted(p.name for p in target.iterdir()), ["events.jsonl", "sentinel"])
+        self.assertEqual((target / "events.jsonl").read_bytes(), ledger)
+        self.assertEqual((target / "sentinel").read_bytes(), b"synthetic sentinel\n")
+
+    def test_hardlinked_ledger_refused_without_mutation(self):
+        m.begin(self.state, start())
+        ledger = self.state / "events.jsonl"
+        alias = Path(self.tmp.name) / "alias-events.jsonl"
+        os.link(ledger, alias)
+        before = alias.read_bytes()
+        self.assertEqual(ledger.stat().st_mode & 0o777, 0o600)
+        self.reject_begin(start("b"))
+        self.assertEqual(alias.read_bytes(), before)
+        self.assertEqual(ledger.read_bytes(), before)
+        self.assertTrue(os.path.samefile(ledger, alias))
+        self.assertEqual(ledger.stat().st_nlink, 2)
+        self.assertEqual(sorted(p.name for p in self.state.iterdir()), ["events.jsonl"])
+
