+    def test_symlink_state_directory_refused_without_mutation(self):
+        target = Path(self.tmp.name) / "target"
+        m.begin(target, start())
+        sentinel = target / "sentinel"; sentinel.write_text("preserve")
+        ledger = (target / "events.jsonl").read_bytes()
+        names = sorted(p.name for p in target.iterdir())
+        alias = Path(self.tmp.name) / "alias"; alias.symlink_to(target, target_is_directory=True)
+        with self.assertRaises(m.MeasurementError): m.begin(alias, start("b"))
+        self.assertTrue(alias.is_symlink())
+        self.assertEqual(os.readlink(alias), str(target))
+        self.assertEqual(sorted(p.name for p in target.iterdir()), names)
+        self.assertEqual((target / "events.jsonl").read_bytes(), ledger)
+        self.assertEqual(sentinel.read_text(), "preserve")
+        self.assertFalse((target / "lock").exists())
+
+    def test_hardlinked_ledger_refused_without_mutation(self):
+        m.begin(self.state, start())
+        ledger = self.state / "events.jsonl"
+        self.assertEqual(ledger.stat().st_mode & 0o777, 0o600)
+        alias = Path(self.tmp.name) / "alias-events.jsonl"; os.link(ledger, alias)
+        before = alias.read_bytes(); inode = ledger.stat().st_ino
+        with self.assertRaises(m.MeasurementError): m.begin(self.state, start("b"))
+        self.assertEqual(alias.read_bytes(), before)
+        self.assertEqual(ledger.read_bytes(), before)
+        self.assertEqual((alias.stat().st_ino, alias.stat().st_nlink), (inode, 2))
+        self.assertEqual(ledger.stat().st_ino, inode)
+        self.assertFalse((self.state / "lock").exists())
+
     def test_malformed_existing_ledger_fails_closed(self):
