/dist/
/bin/
*.exe
*.test
*.out
coverage.*
.idea/
.vscode/
.DS_Store
.env
.env.*

# Claude Code harness: runtime state stays local. Only schemas and seed files
# under .claude/data/ are tracked, the vendor policy seed among them.
.claude/data/*
!.claude/data/*.schema.json
!.claude/data/*.seed.*
!.claude/data/.gitkeep
!.claude/data/vendor-policy.json
.claude/settings.local.json
.claude/worktrees/
.claude/handoffs/
.claude/plans/
.claude/scratch/

# Python bytecode from the harness scripts
__pycache__/

# Autonomous delivery: the run's state stays on the maintainer's machine, in the
# main checkout (scripts/orchestration/delivery.py). Only the README is tracked.
/orchestration/*
!/orchestration/README.md
