/dist/
/bin/
*.exe
*.test
*.out
coverage.*
.idea/
.vscode/
.DS_Store
.env
.env.*

# Claude Code harness: runtime state stays local. Only schemas and seed files
# under .claude/data/ are tracked, the vendor policy seed among them.
.claude/data/*
!.claude/data/*.schema.json
!.claude/data/*.seed.*
!.claude/data/.gitkeep
!.claude/data/vendor-policy.json
.claude/settings.local.json
.claude/worktrees/
.claude/handoffs/
.claude/plans/
.claude/scratch/

# Python bytecode from the harness scripts
__pycache__/

# The approval queue for agent writes: local to each maintainer's checkout
# (scripts/orchestration/approvals.py).
/orchestration/approvals.jsonl
/orchestration/approvals.jsonl.lock
/orchestration/requests/
